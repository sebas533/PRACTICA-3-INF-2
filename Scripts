cat > t02.sh <<'EOF'
#!/bin/bash
P=0; F=0
ok(){ echo -e "  \e[32m[PASS]\e[0m $1"; P=$((P+1)); }
ko(){ echo -e "  \e[31m[FAIL]\e[0m $1"; F=$((F+1)); }
yes_(){ if eval "$2" >/dev/null 2>&1; then ok "$1"; else ko "$1"; fi; }
no_(){  if eval "$2" >/dev/null 2>&1; then ko "$1"; else ok "$1"; fi; }

echo "== Red =="
yes_ "IP 10.21.68.130/29"          "ip -4 addr | grep -q '10.21.68.130/29'"
yes_ "Gateway 10.21.68.129"        "ip route | grep -q 'default via 10.21.68.129'"
yes_ "Ping al gateway (FG port4)"  "ping -c2 -W2 10.21.68.129"
echo "== Servicios =="
yes_ "Apache activo"               "systemctl is-active --quiet apache2"
yes_ "SSH activo"                  "systemctl is-active --quiet ssh"
yes_ "xrdp activo"                 "systemctl is-active --quiet xrdp"
yes_ "Escucha 443"                 "ss -tln | grep -q ':443 '"
yes_ "Escucha 22"                  "ss -tln | grep -q ':22 '"
yes_ "Escucha 3389"                "ss -tln | grep -q ':3389 '"
no_  "Puerto 80 CERRADO"           "ss -tln | grep -q ':80 '"
echo "== Aplicacion =="
yes_ "HTTPS local 200"             "curl -ks -o /dev/null -w '%{http_code}' https://localhost | grep -q 200"
yes_ "Pagina 'Sistema de Caja'"    "curl -ks https://localhost | grep -q 'Sistema de Caja'"
echo "== Internet (debe estar SIN salida con la politica temporal apagada) =="
if ping -c1 -W2 8.8.8.8 >/dev/null 2>&1; then echo "  [INFO] Aun hay Internet: apaga TEMP-SERVERS-INTERNET"; else ok "Sin Internet"; fi
echo; echo "RESULTADO: $P PASS / $F FAIL"
EOF
