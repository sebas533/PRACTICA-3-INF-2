cat > t05.sh <<'EOF'
#!/bin/bash
ROL=${1:-sin}; JUMP=10.21.68.138; WEB=10.21.68.130
IF=$(ls /sys/class/net | grep -v lo | head -n1)
P=0; F=0
ok(){ echo -e "  \e[32m[PASS]\e[0m $1"; P=$((P+1)); }
ko(){ echo -e "  \e[31m[FAIL]\e[0m $1"; F=$((F+1)); }
t(){ if timeout 4 bash -c "exec 3<>/dev/tcp/$1/$2" 2>/dev/null; then R=true; else R=false; fi
     [ "$R" = "$3" ] && ok "$1:$2 -> $R (esperado $3)" || ko "$1:$2 -> $R (esperado $3)"; }

sudo dhclient -r $IF 2>/dev/null; sudo dhclient $IF; sleep 2
IP=$(ip -4 addr show $IF | awk '/inet /{print $2}' | cut -d/ -f1)
echo "== DHCP =="; echo "  IP recibida: $IP"
[ "$ROL" = "sin" ] && ESP=10.21.68.11 || ESP=10.21.68.12
[ "$IP" = "$ESP" ] && ok "IP reservada $ESP" || ko "Esperaba $ESP"
ping -c2 -W2 10.21.68.1 >/dev/null 2>&1 && ok "Ping gateway 10.21.68.1" || ko "Ping gateway"

echo "== Hacia el Jump Server =="
t $JUMP 443 true
if [ "$ROL" = "con" ]; then t $JUMP 22 true; t $JUMP 3389 true
else t $JUMP 22 false; t $JUMP 3389 false; fi
echo "== Hacia el Web Server (debe estar bloqueado) =="
t $WEB 22 false
t $WEB 443 false
t $WEB 3389 false
echo "== Internet (no requerido) =="
ping -c1 -W2 8.8.8.8 >/dev/null 2>&1 && echo "  [INFO] Hay salida a Internet" || echo "  [INFO] Sin salida a Internet"
echo; echo "RESULTADO ($ROL): $P PASS / $F FAIL"
EOF
bash t05.sh sin
